# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public HTTPS URL used for Telegram webhooks
APP_BASE_URL="https://app.example.com"

# Generate independent random values of at least 32 characters
APP_ENCRYPTION_KEY=""
CRON_SECRET=""

# Optional one-time bootstrap. Remove after creating the owner account.
SEED_SUPERADMIN_USERNAME=""
SEED_SUPERADMIN_PASSWORD=""

# Runtime
NODE_ENV="production"
